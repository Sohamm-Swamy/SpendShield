# Supabase project settings -> Data API
# Copy this file to `.env` and fill in your project's values.
# `.env` is gitignored. Restart `npx expo start` after changing it.

# e.g. https://abcdefghijklmnopqrst.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Project settings -> API Keys -> anon / publishable key
EXPO_PUBLIC_SUPABASE_ANON_KEY=